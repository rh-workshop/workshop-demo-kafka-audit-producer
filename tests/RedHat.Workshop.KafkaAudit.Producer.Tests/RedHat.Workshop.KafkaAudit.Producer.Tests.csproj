<Project Sdk="Microsoft.NET.Sdk">
  <!-- TargetFramework/Nullable/ImplicitUsings vienen de Directory.Build.props. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/RedHat.Workshop.KafkaAudit.Producer/RedHat.Workshop.KafkaAudit.Producer.csproj" />
    <!-- El Host se referencia para poder probar HostOptions (la lectura del entorno). -->
    <ProjectReference Include="../../src/RedHat.Workshop.KafkaAudit.Host/RedHat.Workshop.KafkaAudit.Host.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- En un solo sitio, para no repetir el using en cada fichero de test. -->
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
