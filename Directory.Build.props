<!-- Propiedades comunes a los tres proyectos, en un solo sitio: así una subida de
     TargetFramework no puede quedar a medias en un .csproj y romper el paquete. -->
<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
